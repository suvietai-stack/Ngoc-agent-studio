# Create a separate Supabase project. Do not use base-suviet.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server only; set this secret in Vercel and do NOT commit a real key.
OPENAI_API_KEY=
STUDIO_OWNER_UID=SET_ADMIN_AUTH_USER_UUID_IN_VERCEL_ONLY

# v4 app-managed encrypted integrations (server-only)
INTEGRATION_ENCRYPTION_KEY=
# v5 opt-in automatic AI draft worker (independent Ngoc Supabase project only)
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
AUTO_AGENT_RUNNER_ENABLED=false
AUTO_AI_DAILY_LIMIT=3

# OAuth client credentials (server-only). Register the callback below in Google Cloud & Meta.
# https://ngoc-agent-studio.vercel.app/api/integrations/oauth/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
